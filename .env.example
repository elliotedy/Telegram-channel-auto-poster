# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user ID. Multiple admins: 111111111,222222222
ADMIN_IDS=

# IANA timezone used for the posting schedule.
TIMEZONE=UTC

# Optional paths / logging.
DATABASE_PATH=data/autoposter.db
LOG_LEVEL=INFO

# Optional local media folders to watch and import (semicolon or comma separated).
# Example: MEDIA_DIRS=D:\Videos;C:\Users\Me\Downloads\Clips
MEDIA_DIRS=

# Folder import settings
IMPORT_INTERVAL=60
IMPORT_MAX_PER_SCAN=25
IMPORT_RECURSIVE=true
IMPORT_FILENAME_CAPTION=false
MAX_UPLOAD_MB=49.0

# /update runs `git pull` and restarts the process. Disable if you prefer manual updates.
ENABLE_SELF_UPDATE=true

# Send a Telegram message to admins when the bot starts.
NOTIFY_STARTUP=true
