[Unit]
Description=Telegram channel auto poster
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=autoposter
Group=autoposter
WorkingDirectory=/opt/telegram-autoposter
EnvironmentFile=/opt/telegram-autoposter/.env
ExecStart=/opt/telegram-autoposter/.venv/bin/python main.py
Restart=always
RestartSec=10
# The process is a long-running Telegram poller, not a web server.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
